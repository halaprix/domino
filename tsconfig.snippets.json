{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "paths": {
      "@halaprix/domino": ["./dist/index.d.ts"]
    }
  },
  "include": [".snippets-build/**/*.ts", "scripts/check-snippets.ts"]
}
